    vec2 ra=rot(b[a],j.parentAnchor.xy),rb=rot(b[c],j.childAnchor.xy);
    for(int k=0;k<2;++k){vec2 n=k==0?vec2(1,0):vec2(0,1);float eff=effective(a,c,ra,rb,n);if(eff<1e-12)continue;
