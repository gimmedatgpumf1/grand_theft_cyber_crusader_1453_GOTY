    if(twice>1e-10)centerOfArea/=3.0*twice;else centerOfArea=b[index].positionMass.xy;
}
// Integrate pressure drag on each wetted edge. A Cd is supplied by the
// material; the law is quadratic and neglects wake and fluid displacement.
void edgeDrag(int index,vec2 p,vec2 q,float density,vec2 flow) {
    vec2 edge=q-p;float len=length(edge);if(len<1e-8 || density<=0.0)return;
    vec2 normal=vec2(edge.y,-edge.x)/len,center=b[index].positionMass.xy;
    float v0=dot(velocity(b[index],p-center)-flow,normal);
    float v1=dot(velocity(b[index],q-center)-flow,normal);
    if(v0<=0.0 && v1<=0.0)return;
    float lo=0.0,hi=1.0;
    if(v0<0.0)lo=-v0/(v1-v0);
    if(v1<0.0)hi=-v0/(v1-v0);
    float wetLength=len*(hi-lo);
    // Two Gauss points sample the edge. Their impulses are applied in
    // sequence, so the result is an operator-split approximation.
    for(int i=0;i<2;++i){
        float t=mix(lo,hi,i==0?0.2113248654:0.7886751346);
        vec2 r=p+edge*t-center;float vn=max(0.0,dot(velocity(b[index],r)-flow,normal));
        float lever=cross2(r,normal);
        float invMass=b[index].positionMass.w+lever*lever*b[index].inverseInertia.z;
        float coefficient=0.25*density*b[index].material.z*b[index].material.y*wetLength;
        // Exact decay of the local quadratic-drag normal velocity while this
        // quadrature point, its coefficient and the flow are frozen. Unlike
        // explicit Euler it cannot reverse an arbitrarily fast body in one step.
        float impulse=coefficient*vn*vn*step.dt/(1.0+coefficient*invMass*vn*step.dt);
        applyImpulse(index,r,-normal*impulse);
    }
}
void applyFluidForces(int index,inout vec2 force,inout float torque) {
    Body body=b[index];if(body.shapes.y<3u || body.material.y<=0.0)return;
    float belowArea,aboveArea;vec2 belowCenter,aboveCenter;
    submerged(index,true,belowArea,belowCenter);submerged(index,false,aboveArea,aboveCenter);
    vec2 fb=-step.gravityFloor.xy*(step.medium.x*aboveArea+step.medium.y*belowArea)*body.material.y;
    vec2 airForce=-step.gravityFloor.xy*(step.medium.x*aboveArea)*body.material.y;
    vec2 waterForce=-step.gravityFloor.xy*(step.medium.y*belowArea)*body.material.y;
    force+=fb;torque+=cross2(aboveCenter-body.positionMass.xy,airForce)+cross2(belowCenter-body.positionMass.xy,waterForce);
    vec2 v[16];vertices(index,v);int n=int(body.shapes.y);float level=step.medium.z;
    for(int i=0;i<n;++i){vec2 p=v[i],q=v[(i+1)%n];
        bool pBelow=p.y<level,qBelow=q.y<level;
        if(pBelow==qBelow)edgeDrag(index,p,q,pBelow?step.medium.y:step.medium.x,pBelow?step.fluidVelocity.zw:step.fluidVelocity.xy);
        else {vec2 cut=mix(p,q,(level-p.y)/(q.y-p.y));
            edgeDrag(index,p,cut,pBelow?step.medium.y:step.medium.x,pBelow?step.fluidVelocity.zw:step.fluidVelocity.xy);
            edgeDrag(index,cut,q,qBelow?step.medium.y:step.medium.x,qBelow?step.fluidVelocity.zw:step.fluidVelocity.xy);
        }
    }
}
// Scale the residual-velocity fallback by the narrowest cross-section.
// Ordinary resting contacts can then use the iterative solver without
// stalling the entire world for a micrometre of unresolved motion.
void shapeMetrics(int i,out float radius,out float width) {
    int n=int(b[i].shapes.y);radius=0.0;width=1e30;
    for(int k=0;k<n;++k){
        vec2 p=shapes.point[b[i].shapes.x+uint(k)].xy;
        vec2 q=shapes.point[b[i].shapes.x+uint((k+1)%n)].xy;
        radius=max(radius,length(p));vec2 normal=normalize(perp(q-p));
        float lo=dot(p,normal),hi=lo;
        for(int j=1;j<n;++j){float d=dot(shapes.point[b[i].shapes.x+uint(j)].xy,normal);lo=min(lo,d);hi=max(hi,d);}
        width=min(width,hi-lo);
    }
}
bool needsContinuous(int a,int c,float duration,out float scale) {
    float ra,rc,wa,wc;shapeMetrics(a,ra,wa);shapeMetrics(c,rc,wc);
    scale=min(wa,wc)*0.25;
    float speed=length(b[a].linearVelocity.xy-b[c].linearVelocity.xy)+
        abs(b[a].angularVelocity.z)*ra+abs(b[c].angularVelocity.z)*rc;
    return speed*duration>scale;
}
// Round-robin edge coloring of the complete body graph. Each round pairs
// every body at most once; all pairs in the round safely solve concurrently.
ivec2 scheduledPair(int lane,int round,int count) {
    int n=count+(count%2), ring=n-1;
    int a=lane==0?n-1:(round+lane)%ring;
    int c=(round+ring-lane)%ring;
    if(a>c){int t=a;a=c;c=t;}
    return ivec2(a,c);
}
void main(){
    int lane=int(gl_LocalInvocationIndex),count=int(step.first),jointCount=int(step.count);
    if(lane==0){
        dragged=-1;dragTarget=vec2(0);dragAnchor=vec2(0);
        if(step.dragControl.x!=0u && abs(step.dragDirection.z)>1e-6){
            dragTarget=step.dragOrigin.xy-step.dragDirection.xy*(step.dragOrigin.z/step.dragDirection.z);
            if(scratch.word[0]!=step.dragControl.y){
                scratch.word[0]=step.dragControl.y;scratch.word[1]=0u;
                for(int i=count-1;i>=0;--i)if(b[i].positionMass.w>0.0 && b[i].shapes.y>=3u){
                    vec2 v[16];vertices(i,v);
                    if(inside(dragTarget,v,int(b[i].shapes.y))){vec2 anchor=unrot(b[i],dragTarget-b[i].positionMass.xy);
                        scratch.word[1]=uint(i+1);scratch.word[2]=floatBitsToUint(anchor.x);scratch.word[3]=floatBitsToUint(anchor.y);break;}
                }
            }
            if(scratch.word[1]>0u && scratch.word[1]<=uint(count)){
                dragged=int(scratch.word[1]-1u);
                dragAnchor=vec2(uintBitsToFloat(scratch.word[2]),uintBitsToFloat(scratch.word[3]));
            }
        }
    }
    barrier();
    for(int i=lane;i<count;i+=32)if(b[i].positionMass.w>0.0){
        float mass=1.0/b[i].positionMass.w;vec2 force=mass*step.gravityFloor.xy;float torque=0.0;
        applyFluidForces(i,force,torque);
        if(i==dragged){vec2 r=rot(b[i],dragAnchor);float omega=15.0;
            vec2 f=mass*(omega*omega*(dragTarget-b[i].positionMass.xy-r)-2.0*omega*velocity(b[i],r));
            force+=f;torque+=cross2(r,f);
        }
        b[i].linearVelocity.xy+=force*b[i].positionMass.w*step.dt;
        b[i].angularVelocity.z+=torque*b[i].inverseInertia.z*step.dt;
    }
    memoryBarrierBuffer();barrier();
    int n=count+(count%2);
    if(lane==0)remaining=step.dt;
    barrier();
    // Each pass resolves constraints at the current time, finds the globally
    // earliest predicted impact, advances the entire world to that instant,
    // resolves the impact and then re-runs detection with the new velocities.
    // If the event budget or rotational convergence is exhausted, do not
    // integrate the unresolved remainder of this step.
    for(int eventNumber=0;eventNumber<64;++eventNumber){
        for(int a=lane;a<count;a+=32)for(int c=a+1;c<count;++c)makeContact(a,c,count);
        memoryBarrierBuffer();barrier();
        for(int iteration=0;iteration<32;++iteration)for(int round=0;round<n-1;++round){
            for(int slot=lane;slot<n/2;slot+=32){ivec2 pair=scheduledPair(slot,round,count);int a=pair.x,c=pair.y;
                if(c<count){
                    for(int j=0;j<jointCount;++j){Joint joint=joints.joint[j];
                        if(min(joint.bodies.x,joint.bodies.y)==uint(a) && max(joint.bodies.x,joint.bodies.y)==uint(c))solveJointVelocity(joint);
                    }
                    solveContact(a,c,pairIndex(a,c,count));
                }
            }
            memoryBarrierBuffer();barrier();
        }
        Event best;best.time=remaining;best.kind=0;best.a=-1;best.c=-1;
        best.normal=vec2(0);best.anchorA=vec2(0);best.anchorB=vec2(0);
        for(int a=lane;a<count;a+=32)for(int c=a+1;c<count;++c){
            if(b[a].shapes.y<3u || b[c].shapes.y<3u || b[a].positionMass.w+b[c].positionMass.w<=0.0)continue;
            float motionScale;
            bool continuous=needsContinuous(a,c,remaining,motionScale);
            PairContact current=loadPair(pairIndex(a,c,count));
            if(current.count>0u){
                // A finite simultaneous solve may leave closing velocity on an
                // existing contact. Never integrate a large unresolved closing
                // displacement through that contact: stop this step instead.
                float worst=0.0;
                for(int point=0;point<int(current.count);++point){
                    vec2 p=point==0?current.p0:current.p1;
                    float vn=dot(velocity(b[a],p-b[a].positionMass.xy)-velocity(b[c],p-b[c].positionMass.xy),current.n);
                    worst=min(worst,vn);
                }
                if(continuous && -worst*remaining>motionScale){
                    best.time=0.0;best.a=a;best.c=c;best.kind=2;
                }
