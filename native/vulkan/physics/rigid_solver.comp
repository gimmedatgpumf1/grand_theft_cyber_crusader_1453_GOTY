    for(int i=1;i<na;++i){amin=min(amin,dot(a[i],n));initialMin=min(initialMin,dot(initialA[i],n));}
    for(int i=1;i<nb;++i){cmax=max(cmax,dot(c[i],n));initialMax=max(initialMax,dot(initialB[i],n));}
    gap=max(0.0,initialMin-initialMax);
