#version 450

// Experimental Vulkan rigid-body solver used by the test room.
// Joint batches must be graph-coloured: no two joints in one batch may
// reference the same body. Synchronize between batches and solver phases.
// Coordinates are metres, seconds, and radians.
layout(local_size_x = 64) in;

struct Body {
    vec4 positionMass;    // world centre, inverse mass
    vec4 rotation;        // local-to-world quaternion, xyzw
    vec4 linearVelocity;
    vec4 angularVelocity; // w: sorted-proxy axis (xyz is angular velocity)
    vec4 inverseInertia;  // xyz: local-space inverse inertia, w: bounding radius
    vec4 previousPosition; // w is set when a floor contact is resolved
    vec4 previousRotation;
    uvec4 samples;        // x: first sphere, y: count, z: island+1, w: sleeping
    vec4 bounds;          // local proxy AABB half-extents, maximum sphere radius
};
struct Joint {
    uvec4 bodies;         // x = parent body, y = child body
    vec4 parentAnchor;    // body-local anchor
    vec4 childAnchor;
    vec4 parentAxis;      // xyz local axis, w lower angle
    vec4 childAxis;       // xyz local axis, w upper angle
    vec4 parentTangent;
    vec4 childTangent;
    vec4 lowerAngles;
    vec4 upperAngles;
};
layout(std430, set=0, binding=0) coherent buffer Bodies { Body body[]; } bodies;
layout(std430, set=0, binding=1) readonly buffer Joints { Joint joint[]; } joints;
layout(std430, set=0, binding=2) readonly buffer Samples { vec4 point[]; } samples;
// Scratch: eight correction words per body, the symmetric exclusion bitset,
// four world-bound words and four centre/radius words per body, a transient
// broad-phase bitset, then island schedules, sleep state and indirect commands.
// Four storage buffers fit Vulkan 1.0.
layout(std430, set=0, binding=3) buffer Scratch { uint word[]; } scratch;
layout(push_constant) uniform Step {
    uint phase;           // predict, joint, floor, velocity, contacts, apply
    uint first;           // joint offset, or body count in contacts phase
    uint count;           // number of bodies or joints in this dispatch
    float dt;
    vec4 gravityFloor;    // gravity xyz and floor height
    vec4 dragOrigin;
    vec4 dragDirection;
    uvec4 dragControl;    // x active, y press sequence
    vec4 damping;         // free linear/angular, contact linear/angular
    vec4 floorDamping;    // floor tangential/angular
} step;

vec4 qmul(vec4 a, vec4 b) {
    return vec4(a.w*b.xyz+b.w*a.xyz+cross(a.xyz,b.xyz), a.w*b.w-dot(a.xyz,b.xyz));
}
vec3 rotate(vec4 q, vec3 v) {
    return v + 2.0*cross(q.xyz,cross(q.xyz,v)+q.w*v);
}
vec3 worldBounds(Body b) {
    return abs(rotate(b.rotation,vec3(b.bounds.x,0,0))) +
           abs(rotate(b.rotation,vec3(0,b.bounds.y,0))) +
           abs(rotate(b.rotation,vec3(0,0,b.bounds.z)));
}
vec3 invInertia(Body b, vec3 worldVector) {
    vec4 inverseQ=vec4(-b.rotation.xyz,b.rotation.w);
    return rotate(b.rotation,rotate(inverseQ,worldVector)*b.inverseInertia.xyz);
}
void rotateBy(inout Body b, vec3 delta) {
    b.rotation=normalize(b.rotation+0.5*qmul(vec4(delta,0.0),b.rotation));
}

void solveAngular(inout Body a, inout Body b, vec3 axis, float error) {
    vec3 ia=invInertia(a,axis), ib=invInertia(b,axis);
    float effective=dot(axis,ia+ib);
    if (effective<=1e-12) return;
    float impulse=error/effective;
    rotateBy(a,ia*impulse);
    rotateBy(b,-ib*impulse);
}

// Hinge: align its two axes, then clamp the signed twist. Axis and tangent
// frames are captured from the initial calibrated rig.
void solveHinge(inout Body a, inout Body b, Joint j) {
    vec3 axisA=normalize(rotate(a.rotation,j.parentAxis.xyz));
    vec3 axisB=normalize(rotate(b.rotation,j.childAxis.xyz));
    vec3 crossAxis=cross(axisA,axisB);
    float sine=length(crossAxis), cosine=clamp(dot(axisA,axisB),-1.0,1.0);
    if (sine>1e-6) solveAngular(a,b,crossAxis/sine,atan(sine,cosine));
    else if (cosine<0.0) solveAngular(a,b,normalize(rotate(a.rotation,j.parentTangent.xyz)),3.14159265);
    axisA=normalize(rotate(a.rotation,j.parentAxis.xyz));
    vec3 tangentA=rotate(a.rotation,j.parentTangent.xyz);
    vec3 tangentB=rotate(b.rotation,j.childTangent.xyz);
    tangentA-=axisA*dot(axisA,tangentA);
    tangentB-=axisA*dot(axisA,tangentB);
    float aa=length(tangentA), bb=length(tangentB);
    if (aa<1e-6 || bb<1e-6) return;
    tangentA/=aa; tangentB/=bb;
    float angle=atan(dot(axisA,cross(tangentA,tangentB)),dot(tangentA,tangentB));
    float error=angle-clamp(angle,j.parentAxis.w,j.childAxis.w);
    if (abs(error)>1e-6) solveAngular(a,b,axisA,error);
}

// Approximate the three angular coordinates by intrinsic XYZ angles in the
// fitted joint frame. This is not a coupled anatomical limit surface and has
// the usual Euler singularity near 90 degrees of the middle coordinate.
vec3 ballAngles(Body a, Body b, vec3 x, vec3 y, vec3 z, vec3 bx, vec3 by, vec3 bz) {
    vec4 relative=qmul(vec4(-a.rotation.xyz,a.rotation.w),b.rotation);
    vec3 rx=rotate(relative,bx), ry=rotate(relative,by), rz=rotate(relative,bz);
    return vec3(atan(-dot(y,rz),dot(z,rz)),asin(clamp(dot(x,rz),-1.0,1.0)),
                atan(-dot(x,ry),dot(x,rx)));
}
void solveBall(inout Body a, inout Body b, Joint j) {
    vec3 x=normalize(j.parentAxis.xyz), y=normalize(j.parentTangent.xyz), z=normalize(cross(x,y));
    vec3 bx=normalize(j.childAxis.xyz), by=normalize(j.childTangent.xyz), bz=normalize(cross(bx,by));
    vec3 angles=ballAngles(a,b,x,y,z,bx,by,bz);
    bool changed=false;
    for (int k=0;k<3;++k) {
        // Most coordinates are already within their limits. Recompute the
        // expensive trigonometry only after a previous axis changed the pose.
        if (changed) { angles=ballAngles(a,b,x,y,z,bx,by,bz); changed=false; }
        float error=angles[k]-clamp(angles[k],j.lowerAngles[k],j.upperAngles[k]);
        if (abs(error)<1e-6) continue;
        vec3 axis=rotate(a.rotation,x);
        if (k>0) {
            vec4 firstTurn=vec4(axis*sin(angles.x*0.5),cos(angles.x*0.5));
            vec3 worldY=rotate(firstTurn,rotate(a.rotation,y));
            if (k==1) axis=worldY;
            else {
                vec3 worldZ=rotate(firstTurn,rotate(a.rotation,z));
                vec4 middleTurn=vec4(worldY*sin(angles.y*0.5),cos(angles.y*0.5));
                axis=rotate(middleTurn,worldZ);
            }
        }
        solveAngular(a,b,axis,error); changed=true;
    }
}

// Corrects the separation of the two calibrated anchors. A coloured batch
// makes each body writable by just one invocation, without float atomics.
void solveJoint(uint index) {
    Joint j=joints.joint[index];
    Body a=bodies.body[j.bodies.x], b=bodies.body[j.bodies.y];
    if (a.samples.w!=0u) return;
    for (int k=0;k<3;++k) {
        vec3 n=vec3(k==0 ? 1.0 : 0.0,k==1 ? 1.0 : 0.0,k==2 ? 1.0 : 0.0);
        vec3 ra=rotate(a.rotation,j.parentAnchor.xyz);
        vec3 rb=rotate(b.rotation,j.childAnchor.xyz);
        float error=dot((b.positionMass.xyz+rb)-(a.positionMass.xyz+ra),n);
        if (abs(error)<1e-8) continue;
        vec3 aa=cross(ra,n), ab=cross(rb,n);
        vec3 ia=invInertia(a,aa), ib=invInertia(b,ab);
        float effective=a.positionMass.w+b.positionMass.w+dot(aa,ia)+dot(ab,ib);
        if (effective<=1e-12) continue;
        float impulse=error/effective;
        a.positionMass.xyz+=n*(impulse*a.positionMass.w);
        b.positionMass.xyz-=n*(impulse*b.positionMass.w);
        rotateBy(a,ia*impulse);
        rotateBy(b,-ib*impulse);
    }
    if (j.bodies.z==0u) solveBall(a,b,j);
    else if (j.bodies.z==1u) solveHinge(a,b,j);
    // Angular correction can move anchors apart again. Close the remaining
    // gap by inverse-mass weighted translation, just as the old hand solver
    // projected tiny finger anchors after constraint solving.
    float weight=a.positionMass.w+b.positionMass.w;
    if (weight>1e-12) {
        vec3 separation=(b.positionMass.xyz+rotate(b.rotation,j.childAnchor.xyz))-
                        (a.positionMass.xyz+rotate(a.rotation,j.parentAnchor.xyz));
        a.positionMass.xyz+=separation*(a.positionMass.w/weight);
        b.positionMass.xyz-=separation*(b.positionMass.w/weight);
    }
    bodies.body[j.bodies.x]=a;
    bodies.body[j.bodies.y]=b;
}

// Floor support points are local to their rigid body. A body owns all its
// support points, so this phase is also one writer per body.
void storeBounds(uint index, uint count, Body b) {
    uint offset=count*8u+count*((count+31u)/32u)+index*4u;
    uint centerOffset=offset+count*4u;
    vec3 extent=worldBounds(b);
    for (uint k=0u;k<3u;++k) {
        scratch.word[offset+k]=floatBitsToUint(extent[k]);
        scratch.word[centerOffset+k]=floatBitsToUint(b.positionMass[k]);
    }
    scratch.word[centerOffset+3u]=floatBitsToUint(b.inverseInertia.w);
}
vec3 loadBounds(uint index, uint count) {
    uint offset=count*8u+count*((count+31u)/32u)+index*4u;
    return vec3(uintBitsToFloat(scratch.word[offset]),uintBitsToFloat(scratch.word[offset+1u]),
                uintBitsToFloat(scratch.word[offset+2u]));
}
vec4 loadCenter(uint index, uint count) {
    uint offset=count*12u+count*((count+31u)/32u)+index*4u;
    return vec4(uintBitsToFloat(scratch.word[offset]),uintBitsToFloat(scratch.word[offset+1u]),
                uintBitsToFloat(scratch.word[offset+2u]),uintBitsToFloat(scratch.word[offset+3u]));
}
uint candidateOffset(uint count) { return count*16u+count*((count+31u)/32u); }
uint islandBase(uint count) { return count*16u+2u*count*((count+31u)/32u); }
uint islandRecord(uint count, uint island) {
    uint base=islandBase(count), colours=scratch.word[base];
    return base+2u+island*(5u+2u*colours);
}
uint islandState(uint count, uint island) {
    uint base=islandBase(count);
    return islandRecord(count,island)+2u+2u*scratch.word[base];
}
uint poseOffset(uint count, uint bodyIndex) {
    uint base=islandBase(count);
    return base+scratch.word[base+1u]+bodyIndex*8u;
}
uint dragOffset(uint count) {
    uint base=islandBase(count);
    return base+scratch.word[base+1u]+count*8u+12u;
}
uint draggedBody(uint count) {
    return step.dragControl.x!=0u ? scratch.word[dragOffset(count)+1u] : 0u;
}
void saveRestReference(uint count, uint index, Body b) {
    uint offset=poseOffset(count,index);
    for (uint k=0u;k<3u;++k) scratch.word[offset+k]=floatBitsToUint(b.positionMass[k]);
    for (uint k=0u;k<4u;++k) scratch.word[offset+4u+k]=floatBitsToUint(b.rotation[k]);
}

// One invocation owns one 32-body word. The broad phase is independently
// parallel and writes a compact list of candidates for the narrow phase.
void findCandidates(uint wordIndex) {
    uint count=step.first, stride=(count+31u)/32u;
    uint index=wordIndex/stride, word=wordIndex%stride;
    uint excluded=scratch.word[count*8u+wordIndex], mask=0u;
    if (bodies.body[index].samples.w!=0u) {
        scratch.word[candidateOffset(count)+wordIndex]=0u;
        return;
    }
    vec4 a=loadCenter(index,count);
    vec3 extentA=loadBounds(index,count);
    for (uint bit=0u;bit<32u;++bit) {
        uint other=word*32u+bit;
        if (other>=count || other==index || (excluded&(1u<<bit))!=0u) continue;
        vec4 b=loadCenter(other,count);
        vec3 separation=a.xyz-b.xyz;
        float radius=a.w+b.w;
        if (dot(separation,separation)>radius*radius) continue;
        if (any(greaterThan(abs(separation),extentA+loadBounds(other,count)+vec3(1e-5)))) continue;
        mask|=1u<<bit;
    }
    scratch.word[candidateOffset(count)+wordIndex]=mask;
}
void solveFloor(uint index, bool saveBounds) {
    Body b=bodies.body[index];
    if (b.samples.w!=0u) return;
    // The enclosing sphere is conservative for all proxies. Most bodies are
    // nowhere near the floor during a drop, so do not scan all their samples.
    if (b.positionMass.w<=0.0 || b.positionMass.y-b.inverseInertia.w>=step.gravityFloor.w) {
        if (saveBounds) storeBounds(index,step.first,b);
        return;
    }
    float lowest=step.gravityFloor.w;
    // Only the Y component of each rotated proxy is needed for support.
    vec3 upLocal=rotate(vec4(-b.rotation.xyz,b.rotation.w),vec3(0.0,1.0,0.0));
    vec3 arm=vec3(0.0), localPoint=vec3(0.0);
    float pointRadius=0.0;
    for (uint i=0u;i<b.samples.y;++i) {
        vec4 sphere=samples.point[b.samples.x+i];
        float y=b.positionMass.y+dot(upLocal,sphere.xyz)-sphere.w;
        if (y<lowest) {
            lowest=y; localPoint=sphere.xyz; pointRadius=sphere.w;
        }
    }
    if (lowest<step.gravityFloor.w) {
        arm=rotate(b.rotation,localPoint)-vec3(0.0,pointRadius,0.0);
        vec3 n=vec3(0.0,1.0,0.0);
        vec3 torque=cross(arm,n), angular=invInertia(b,torque);
        float effective=b.positionMass.w+dot(torque,angular);
        if (effective>1e-12) {
            float impulse=(step.gravityFloor.w-lowest)/effective;
            b.positionMass.xyz+=n*(impulse*b.positionMass.w);
            rotateBy(b,angular*impulse);
            // Resist tangential movement of the actual contact point, not
            // only translation of the body's centre. This gives the floor
            // leverage against spinning and is bounded by the normal impulse.
            arm=rotate(b.rotation,localPoint)-vec3(0.0,pointRadius,0.0);
            vec3 previousArm=rotate(b.previousRotation,localPoint)-vec3(0.0,pointRadius,0.0);
            vec3 slip=(b.positionMass.xyz+arm)-(b.previousPosition.xyz+previousArm);
            slip.y=0.0;
            float distance=length(slip);
            if (distance>1e-7) {
                vec3 tangent=slip/distance;
                vec3 tangentTorque=cross(arm,tangent), tangentInertia=invInertia(b,tangentTorque);
                float tangentMass=b.positionMass.w+dot(tangentTorque,tangentInertia);
                if (tangentMass>1e-12) {
                    float friction=min(distance/tangentMass,0.8*impulse);
                    b.positionMass.xyz-=tangent*(friction*b.positionMass.w);
                    rotateBy(b,-tangentInertia*friction);
                }
            }
            b.previousPosition.w=1.0;
        }
    }
    bodies.body[index]=b;
    if (saveBounds) storeBounds(index,step.first,b);
}

// Pick directly from the current GPU proxies; the host never reads body poses.
shared float pickDistance[64];
shared uint pickBody[64];
float raySphere(vec3 origin, vec3 direction, vec3 center, float radius) {
    vec3 relative=origin-center;
    float along=dot(relative,direction);
    float discriminant=along*along-dot(relative,relative)+radius*radius;
    if (discriminant<0.0) return 1e30;
    float t=-along-sqrt(discriminant);
    if (t<0.0) t=-along+sqrt(discriminant);
    return t>=0.0 ? t : 1e30;
}
void pickDrag(uint lane) {
    uint count=step.first, offset=dragOffset(count);
    if (scratch.word[offset]==step.dragControl.y) return;
    vec3 origin=step.dragOrigin.xyz, direction=step.dragDirection.xyz;
    float limit=25.0;
    if (direction.y< -1e-6) {
        float floorDistance=(step.gravityFloor.w-origin.y)/direction.y;
        if (floorDistance>0.0) limit=min(limit,floorDistance+0.015);
    }
    float best=limit;
    uint selected=0u;
    for (uint index=lane;index<count;index+=64u) {
        Body b=bodies.body[index];
        if (b.positionMass.w<=0.0 || raySphere(origin,direction,b.positionMass.xyz,b.inverseInertia.w+0.012)>=best) continue;
        for (uint i=0u;i<b.samples.y;++i) {
            vec4 sphere=samples.point[b.samples.x+i];
            vec3 center=b.positionMass.xyz+rotate(b.rotation,sphere.xyz);
            float t=raySphere(origin,direction,center,sphere.w+0.012);
            if (t<best) { best=t; selected=index+1u; }
        }
    }
    pickDistance[lane]=best; pickBody[lane]=selected;
    barrier();
    for (uint width=32u;width>0u;width>>=1u) {
        if (lane<width && pickDistance[lane+width]<pickDistance[lane]) {
            pickDistance[lane]=pickDistance[lane+width]; pickBody[lane]=pickBody[lane+width];
        }
        barrier();
    }
    if (lane==0u) {
        uint hit=pickBody[0];
        scratch.word[offset]=step.dragControl.y;
        scratch.word[offset+1u]=hit;
        if (hit!=0u) {
            Body b=bodies.body[hit-1u];
            vec3 point=origin+direction*pickDistance[0]-b.positionMass.xyz;
            vec3 local=rotate(vec4(-b.rotation.xyz,b.rotation.w),point);
            scratch.word[offset+2u]=floatBitsToUint(pickDistance[0]);
            for (uint k=0u;k<3u;++k) scratch.word[offset+3u+k]=floatBitsToUint(local[k]);
        }
    }
}

void solveDrag(uint index, uint count) {
    uint offset=dragOffset(count);
    Body b=bodies.body[index];
    vec3 local=vec3(uintBitsToFloat(scratch.word[offset+3u]),uintBitsToFloat(scratch.word[offset+4u]),
                    uintBitsToFloat(scratch.word[offset+5u]));
    vec3 target=step.dragOrigin.xyz+step.dragDirection.xyz*uintBitsToFloat(scratch.word[offset+2u]);
    for (int k=0;k<3;++k) {
        vec3 axis=vec3(k==0 ? 1.0 : 0.0,k==1 ? 1.0 : 0.0,k==2 ? 1.0 : 0.0);
        vec3 arm=rotate(b.rotation,local);
        float error=dot(target-b.positionMass.xyz-arm,axis);
        vec3 torque=cross(arm,axis), angular=invInertia(b,torque);
        float effective=b.positionMass.w+dot(torque,angular);
        if (effective<=1e-12) continue;
        float impulse=clamp(error*0.20/effective,-0.04/b.positionMass.w,0.04/b.positionMass.w);
        vec3 turn=angular*impulse;
        float angle=length(turn);
        if (angle>0.06) turn*=0.06/angle;
        b.positionMass.xyz+=axis*(impulse*b.positionMass.w);
        rotateBy(b,turn);
    }
    bodies.body[index]=b;
}

// Give the connected figure a bounded translation toward the pointer before
// solving its joints, then pull at the actual grabbed point. This avoids
// tearing a small bone away from a much heavier articulated body.
shared vec3 dragShift;
void dragIsland(uint lane) {
    uint count=step.first, held=draggedBody(count);
    if (held==0u) return;
    Body grabbed=bodies.body[held-1u];
    if (grabbed.samples.w!=0u || grabbed.samples.z==0u) return;
    uint base=islandBase(count), record=islandRecord(count,grabbed.samples.z-1u);
    uint first=base+scratch.word[record], n=scratch.word[record+1u];
    if (lane==0u) {
        uint offset=dragOffset(count);
        vec3 local=vec3(uintBitsToFloat(scratch.word[offset+3u]),uintBitsToFloat(scratch.word[offset+4u]),
                        uintBitsToFloat(scratch.word[offset+5u]));
        vec3 target=step.dragOrigin.xyz+step.dragDirection.xyz*uintBitsToFloat(scratch.word[offset+2u]);
        vec3 delta=(target-grabbed.positionMass.xyz-rotate(grabbed.rotation,local))*0.10;
        float distance=length(delta);
        dragShift=distance>0.025 ? delta*(0.025/distance) : delta;
    }
    barrier();
    for (uint i=lane;i<n;i+=64u) {
        uint index=scratch.word[first+i];
        Body b=bodies.body[index];
        if (b.positionMass.w<=0.0) continue;
        b.positionMass.xyz+=dragShift;
        bodies.body[index]=b;
    }
    memoryBarrierBuffer(); barrier();
    if (lane==0u) solveDrag(held-1u,count);
}

// Joint islands have disjoint bodies. Their graph-coloured constraints and
// floor corrections can be ordered with workgroup barriers rather than one
// global Vulkan dispatch and pipeline barrier per colour.
void solveIsland(uint island, uint lane) {
    uint count=step.first;
    uint base=islandBase(count), colours=scratch.word[base];
    uint record=islandRecord(count,island);
    uint bodyFirst=base+scratch.word[record], bodyCount=scratch.word[record+1u];
    if (bodyCount==0u || bodies.body[scratch.word[bodyFirst]].samples.w!=0u) return;
    for (uint pass=0u;pass<2u;++pass) {
        for (uint colour=0u;colour<colours;++colour) {
            uint first=base+scratch.word[record+2u+colour*2u];
            uint n=scratch.word[record+3u+colour*2u];
            for (uint i=lane;i<n;i+=64u) solveJoint(scratch.word[first+i]);
            memoryBarrierBuffer(); barrier();
        }
        for (uint i=lane;i<bodyCount;i+=64u) solveFloor(scratch.word[bodyFirst+i],pass==1u);
        memoryBarrierBuffer(); barrier();
    }
}

// The room's toe joint frames start aligned in each body's identity frame.
// Keep the simulated hinge coordinate, clamp it, then reconstruct the child
// orientation and its marked anchor exactly (up to float rounding). Unlike
// the iterative impulse solve, no off-axis rotation or anchor gap survives.
void projectToe(uint index) {
    Joint j=joints.joint[index];
    Body a=bodies.body[j.bodies.x], b=bodies.body[j.bodies.y];
    vec3 axis=normalize(j.parentAxis.xyz);
    vec4 relative=qmul(vec4(-a.rotation.xyz,a.rotation.w),b.rotation);
    float p=dot(relative.xyz,axis);
    float angle=(abs(p)+abs(relative.w)>1e-8) ? 2.0*atan(p,relative.w) : 0.0;
    angle=atan(sin(angle),cos(angle));
    angle=clamp(angle,j.parentAxis.w,j.childAxis.w);
    vec4 turn=vec4(axis*sin(angle*0.5),cos(angle*0.5));
    b.rotation=normalize(qmul(a.rotation,turn));
    b.positionMass.xyz=a.positionMass.xyz+rotate(a.rotation,j.parentAnchor.xyz)-rotate(b.rotation,j.childAnchor.xyz);
    bodies.body[j.bodies.y]=b;
}

// Independent toe chains project in parallel. A barrier separates the base,
// middle and distal depths so no later projection can move an earlier parent.
void projectToeIsland(uint island, uint lane) {
    uint count=step.first, base=islandBase(count), colours=scratch.word[base];
    uint record=islandRecord(count,island);
    uint bodyFirst=base+scratch.word[record], bodyCount=scratch.word[record+1u];
    if (bodyCount==0u || bodies.body[scratch.word[bodyFirst]].samples.w!=0u) return;
    for(uint depth=1u;depth<=3u;++depth) {
        for(uint colour=0u;colour<colours;++colour) {
            uint first=base+scratch.word[record+2u+colour*2u];
            uint n=scratch.word[record+3u+colour*2u];
            for(uint i=lane;i<n;i+=64u) {
                uint index=scratch.word[first+i];
                if(joints.joint[index].bodies.w==depth) projectToe(index);
            }
        }
        memoryBarrierBuffer(); barrier();
    }
}

// Sleeping is an island decision: connected bodies never freeze individually.
// Wake decisions read last step's immutable sleep flags and are committed by
// the following prediction dispatch, avoiding inter-workgroup races. A moving
// neighbouring island wakes a resting one before it can strike its proxies.
shared uint wakeLanes[64];
shared float motionLanes[64];
shared float maxMotionLanes[64];
shared uint supportLanes[64];
shared uint islandSleep;
void wakeIsland(uint island, uint lane) {
    uint count=step.first, base=islandBase(count), record=islandRecord(count,island);
    uint first=base+scratch.word[record], n=scratch.word[record+1u];
    bool sleeping=n!=0u && bodies.body[scratch.word[first]].samples.w!=0u;
    uint held=draggedBody(count);
    if (sleeping && held!=0u && bodies.body[held-1u].samples.z==island+1u) {
        if (lane==0u) {
            uint state=islandState(count,island);
            scratch.word[state]=0u; scratch.word[state+1u]=1u; scratch.word[state+2u]=0u;
        }
        return;
    }
    bool anyAwake=false;
    if (sleeping) for (uint other=0u;other<step.count;++other) {
        uint otherRecord=islandRecord(count,other);
        uint otherFirst=base+scratch.word[otherRecord];
        if (scratch.word[otherRecord+1u]!=0u && bodies.body[scratch.word[otherFirst]].samples.w==0u) {
            anyAwake=true; break;
        }
    }
    if (!sleeping || !anyAwake) {
        if (lane==0u) scratch.word[islandState(count,island)+1u]=0u;
        return;
    }
    uint found=0u;
    for (uint i=lane;i<n;i+=64u) {
        Body a=bodies.body[scratch.word[first+i]];
        vec3 extentA=worldBounds(a);
        for (uint j=0u;j<count;++j) {
            Body b=bodies.body[j];
            if (b.samples.w!=0u || b.samples.z==a.samples.z || b.positionMass.w<=0.0) continue;
            // Cull distant pairs before calculating speeds or transformed
            // bounds. Only an approaching impact (or deliberate grab) wakes
            // a pile; jitter on a neighbouring bone is not enough.
            vec3 delta=a.positionMass.xyz-b.positionMass.xyz;
            float reach=a.inverseInertia.w+b.inverseInertia.w+0.165;
            float distanceSquared=dot(delta,delta);
            if (distanceSquared>reach*reach) continue;
            bool grabbed=held!=0u && bodies.body[held-1u].samples.z==b.samples.z;
            float speed=length(b.linearVelocity.xyz)+b.inverseInertia.w*length(b.angularVelocity.xyz);
            if (!grabbed && speed<0.65) continue;
            float margin=0.015+min(speed*step.dt*2.0,0.15);
            reach=a.inverseInertia.w+b.inverseInertia.w+margin;
            if (distanceSquared>reach*reach ||
                any(greaterThan(abs(delta),extentA+worldBounds(b)+vec3(margin)))) continue;
            vec3 direction=distanceSquared>1e-10 ? delta*inversesqrt(distanceSquared) : vec3(0.0,1.0,0.0);
            vec3 localPoint=rotate(vec4(-b.rotation.xyz,b.rotation.w),delta);
            vec3 arm=rotate(b.rotation,clamp(localPoint,-b.bounds.xyz,b.bounds.xyz));
            vec3 contactVelocity=b.linearVelocity.xyz+cross(b.angularVelocity.xyz,arm);
            if (grabbed || dot(contactVelocity,direction)>0.5) { found=1u; break; }
        }
    }
    wakeLanes[lane]=found;
    barrier();
    for (uint width=32u;width>0u;width>>=1u) {
        if (lane<width) wakeLanes[lane]|=wakeLanes[lane+width];
        barrier();
    }
    if (lane==0u) {
        uint state=islandState(count,island);
        scratch.word[state+1u]=wakeLanes[0];
        if (wakeLanes[0]!=0u) { scratch.word[state]=0u; scratch.word[state+2u]=0u; }
    }
}

void settleIsland(uint island, uint lane) {
    uint count=step.first, base=islandBase(count), record=islandRecord(count,island);
    uint first=base+scratch.word[record], n=scratch.word[record+1u];
    if (n==0u || bodies.body[scratch.word[first]].samples.w!=0u) return;
    uint state=islandState(count,island);
    uint held=draggedBody(count);
    if (held!=0u && bodies.body[held-1u].samples.z==island+1u) {
        if (lane==0u) { scratch.word[state]=0u; scratch.word[state+2u]=0u; }
        return;
    }
    // Inspect displacement against a half-second-old reference pose. This
    // recognizes small oscillations even when per-step reconstructed velocity
    // is noisy, without sleeping a figure that is still travelling or falling.
    float elapsed=uintBitsToFloat(scratch.word[state])+step.dt;
    barrier();
    if (elapsed<0.5-1e-6) {
        if (lane==0u) scratch.word[state]=floatBitsToUint(elapsed);
        return;
    }
    float total=0.0, largest=0.0, speedTotal=0.0;
    uint support=0u, dynamicCount=0u;
    for (uint i=lane;i<n;i+=64u) {
        uint index=scratch.word[first+i], offset=poseOffset(count,index);
        Body b=bodies.body[index];
        if (b.positionMass.w<=0.0) continue;
        vec3 refPosition=vec3(uintBitsToFloat(scratch.word[offset]),uintBitsToFloat(scratch.word[offset+1u]),
                              uintBitsToFloat(scratch.word[offset+2u]));
        vec4 refRotation=vec4(uintBitsToFloat(scratch.word[offset+4u]),uintBitsToFloat(scratch.word[offset+5u]),
                              uintBitsToFloat(scratch.word[offset+6u]),uintBitsToFloat(scratch.word[offset+7u]));
        float alignment=clamp(abs(dot(refRotation,b.rotation)),0.0,1.0);
        float movement=length(b.positionMass.xyz-refPosition)+
                       2.0*b.inverseInertia.w*sqrt(max(0.0,1.0-alignment*alignment));
        total+=movement; largest=max(largest,movement);
        speedTotal+=length(b.linearVelocity.xyz)+b.inverseInertia.w*length(b.angularVelocity.xyz);
        ++dynamicCount;
        // Support may come from the floor or another figure underneath.
        if (b.previousPosition.w>0.0 || (scratch.word[index*8u+3u]&1u)!=0u) support=1u;
    }
    motionLanes[lane]=total;
    maxMotionLanes[lane]=largest;
    // Reuse the wake reduction array to sum a floating-point speed safely.
    wakeLanes[lane]=floatBitsToUint(speedTotal);
    supportLanes[lane]=support | (dynamicCount<<1u);
    barrier();
    for (uint width=32u;width>0u;width>>=1u) {
        if (lane<width) {
            motionLanes[lane]+=motionLanes[lane+width];
            maxMotionLanes[lane]=max(maxMotionLanes[lane],maxMotionLanes[lane+width]);
            wakeLanes[lane]=floatBitsToUint(uintBitsToFloat(wakeLanes[lane])+uintBitsToFloat(wakeLanes[lane+width]));
            uint a=supportLanes[lane], b=supportLanes[lane+width];
            supportLanes[lane]=((a&1u)|(b&1u)) + ((a>>1u)+(b>>1u))*2u;
        }
        barrier();
    }
    uint dynamicCountTotal=supportLanes[0]>>1u;
    bool quiet=(supportLanes[0]&1u)!=0u && dynamicCountTotal>0u &&
               motionLanes[0]/float(dynamicCountTotal)<0.055 && maxMotionLanes[0]<0.18 &&
               uintBitsToFloat(wakeLanes[0])/float(dynamicCountTotal)<0.55;
    if (lane==0u) {
        scratch.word[state]=0u;
        uint windows=quiet ? min(scratch.word[state+2u]+1u,2u) : 0u;
        scratch.word[state+2u]=windows;
        islandSleep=windows>=2u ? 1u : 0u;
    }
    barrier();
    bool sleep=islandSleep!=0u;
    for (uint i=lane;i<n;i+=64u) {
        uint index=scratch.word[first+i];
        if (sleep) {
            // Contacts are the last ordinary projection, so make sure the
            // resting pose is above the floor before freezing it.
            solveFloor(index,true);
            Body b=bodies.body[index];
            b.linearVelocity.xyz=vec3(0.0); b.angularVelocity.xyz=vec3(0.0);
            b.samples.w=1u;
            bodies.body[index]=b;
        } else {
            saveRestReference(count,index,bodies.body[index]);
        }
    }
}

// Four lanes search candidate bodies for one body, with sixteen bodies per
// workgroup. Each lane writes to private shared-memory slots before reduction,
// so no float atomics or inter-workgroup writes are needed. Broad phase
// remains all-pairs; a spatial accelerator is needed for larger scenes.
shared vec4 contactPosition[64];
shared vec4 contactRotation[64];
shared uint contactFlags[64];
void findContacts(uint index, uint lane, uint localIndex) {
    uint bodyCount=step.first;
    bool valid=index<bodyCount;
    Body a=bodies.body[min(index,bodyCount-1u)];
    vec3 positionDelta=vec3(0.0), rotationDelta=vec3(0.0);
    float contactCount=0.0;
    uint flags=0u;
    uint stride=(bodyCount+31u)/32u;
    if (valid && a.samples.w==0u && a.positionMass.w>0.0) for (uint word=lane;word<stride;word+=4u) {
      uint candidates=scratch.word[candidateOffset(bodyCount)+index*stride+word];
      while (candidates!=0u) {
        uint bit=uint(findLSB(candidates));
        candidates&=candidates-1u;
        uint other=word*32u+bit;
        Body b=bodies.body[other];
        vec3 separation=a.positionMass.xyz-b.positionMass.xyz;
        float depth=0.0;
        vec3 bestLocal=vec3(0.0), bestA=vec3(0.0), bestB=vec3(0.0);
        float bestRadiusA=0.0, bestRadiusB=0.0, bestDistance=0.0;
        vec4 inverseB=vec4(-b.rotation.xyz,b.rotation.w);
        // Transform A directly into B's frame. Compose the rotations and
        // transform the centre once per pair, not twice for every proxy.
        vec4 relativeRotation=qmul(inverseB,a.rotation);
        vec3 localSeparation=rotate(inverseB,separation);
        for (uint i=0u;i<a.samples.y;++i) {
            vec4 sa=samples.point[a.samples.x+i];
            vec3 localCenter=localSeparation+rotate(relativeRotation,sa.xyz);
            float candidateRadius=b.inverseInertia.w+sa.w;
            if (dot(localCenter,localCenter)>candidateRadius*candidateRadius) continue;
            if (any(greaterThan(abs(localCenter),b.bounds.xyz+vec3(sa.w+1e-5)))) continue;
            // B's proxies are sorted once along its longest local axis. Find
            // the first possible overlap, then stop at the far end of the
            // conservative sphere interval instead of scanning every proxy.
            uint axis=uint(b.angularVelocity.w);
            float reach=sa.w+b.bounds.w+1e-5;
            float lo=localCenter[axis]-reach, hi=localCenter[axis]+reach;
            uint left=0u, right=b.samples.y;
            while (left<right) {
                uint middle=(left+right)/2u;
                if (samples.point[b.samples.x+middle][axis]<lo) left=middle+1u;
                else right=middle;
            }
            for (uint j=left;j<b.samples.y;++j) {
                vec4 sb=samples.point[b.samples.x+j];
                if (sb[axis]>hi) break;
                vec3 d=localCenter-sb.xyz;
                float radius=sa.w+sb.w, distanceSquared=dot(d,d);
                if (distanceSquared>=radius*radius) continue;
                float distance=sqrt(distanceSquared), overlap=radius-distance;
                if (overlap<=depth) continue;
                depth=overlap; bestLocal=d; bestA=sa.xyz; bestB=sb.xyz;
                bestRadiusA=sa.w; bestRadiusB=sb.w; bestDistance=distance;
            }
        }
        if (depth<=0.0) continue;
        vec3 bestNormal=bestDistance>1e-7 ? rotate(b.rotation,bestLocal/bestDistance)
                                           : vec3(index<other ? -1.0 : 1.0,0.0,0.0);
        // A sleeping body is immovable until an actual wake decision. Using
        // its dynamic mass here would leave half the penetration unresolved.
        float massB=b.samples.w!=0u ? 0.0 : b.positionMass.w;
        vec3 armA=rotate(a.rotation,bestA)-bestNormal*bestRadiusA;
        vec3 armB=rotate(b.rotation,bestB)+bestNormal*bestRadiusB;
        vec3 ta=cross(armA,bestNormal), tb=cross(armB,bestNormal);
        vec3 ia=invInertia(a,ta), ib=massB>0.0 ? invInertia(b,tb) : vec3(0.0);
        float effective=a.positionMass.w+massB+dot(ta,ia)+dot(tb,ib);
        if (effective<=1e-12) continue;
        // Proxy surfaces may overlap at rest. A small slop and bounded
        // correction stop them pumping energy into the joint chains.
        float impulse=min(max(depth-0.001,0.0),0.012)/effective;
        positionDelta+=bestNormal*(impulse*a.positionMass.w);
        rotationDelta+=ia*impulse;
        if (a.samples.z!=b.samples.z && bestNormal.y>0.35) flags|=1u;
        flags|=2u;
        // Coulomb-like positional friction at the actual contact point. The
        // same pair is solved from both bodies without cross-workgroup writes.
        vec3 prevA=rotate(a.previousRotation,rotate(vec4(-a.rotation.xyz,a.rotation.w),armA));
        vec3 slip=(a.positionMass.xyz+armA)-(a.previousPosition.xyz+prevA);
        if (massB>0.0) {
            vec3 prevB=rotate(b.previousRotation,rotate(vec4(-b.rotation.xyz,b.rotation.w),armB));
            slip-=(b.positionMass.xyz+armB)-(b.previousPosition.xyz+prevB);
        }
        slip-=bestNormal*dot(slip,bestNormal);
        float slipLength=length(slip);
        if (slipLength>1e-6 && impulse>0.0) {
            vec3 tangent=slip/slipLength;
            vec3 fa=cross(armA,tangent), fb=cross(armB,tangent);
            vec3 fia=invInertia(a,fa), fib=massB>0.0 ? invInertia(b,fb) : vec3(0.0);
            float tangentMass=a.positionMass.w+massB+dot(fa,fia)+dot(fb,fib);
            if (tangentMass>1e-12) {
                float friction=min(slipLength/tangentMass,0.5*impulse);
                positionDelta-=tangent*(friction*a.positionMass.w);
                rotationDelta-=fia*friction;
            }
        }
        contactCount+=1.0;
      }
    }
    contactPosition[localIndex]=vec4(positionDelta,contactCount);
    contactRotation[localIndex]=vec4(rotationDelta,0.0);
    contactFlags[localIndex]=flags;
    barrier();
    for (uint width=2u;width>0u;width>>=1u) {
        if (lane<width) {
            contactPosition[localIndex]+=contactPosition[localIndex+width];
            contactRotation[localIndex]+=contactRotation[localIndex+width];
            contactFlags[localIndex]|=contactFlags[localIndex+width];
        }
        barrier();
    }
    if (valid && lane==0u) {
        float scale=contactPosition[localIndex].w>0.0 ? 0.8/max(1.0,contactPosition[localIndex].w) : 0.0;
        vec3 translation=contactPosition[localIndex].xyz*scale, rotation=contactRotation[localIndex].xyz*scale;
        uint offset=index*8u;
        scratch.word[offset+3u]|=contactFlags[localIndex];
        for (uint k=0u;k<3u;++k) {
            scratch.word[offset+k]=floatBitsToUint(translation[k]);
            scratch.word[offset+4u+k]=floatBitsToUint(rotation[k]);
        }
    }
}

// The following indirect dispatches can be empty while the whole world is
// asleep. Wake detection still executes every step and re-enables them.
void scheduleAwakeWork() {
    uint count=step.first, base=islandBase(count), hasAwake=0u;
    for (uint island=0u;island<step.count;++island) {
        uint record=islandRecord(count,island), first=base+scratch.word[record];
        if (scratch.word[record+1u]!=0u &&
            (bodies.body[scratch.word[first]].samples.w==0u || scratch.word[islandState(count,island)+1u]!=0u)) {
            hasAwake=1u; break;
        }
    }
    uint offset=base+scratch.word[base+1u]+count*8u;
    uint stride=(count+31u)/32u;
    uint groups[4]=uint[4]((count+63u)/64u,step.count,(count*stride+63u)/64u,(count+15u)/16u);
    for (uint i=0u;i<4u;++i) {
        scratch.word[offset+i*3u]=hasAwake*groups[i];
        scratch.word[offset+i*3u+1u]=1u;
        scratch.word[offset+i*3u+2u]=1u;
    }
}

void main() {
    if (step.phase==13u || step.phase==14u) {
        projectToeIsland(gl_WorkGroupID.x,gl_LocalInvocationIndex);
        return;
    }
    if (step.phase==12u) {
        dragIsland(gl_LocalInvocationIndex);
        return;
    }
    if (step.phase==11u) {
        pickDrag(gl_LocalInvocationIndex);
        return;
    }
    if (step.phase==10u) {
        if (gl_GlobalInvocationID.x==0u) scheduleAwakeWork();
        return;
    }
    if (step.phase==7u) {
        solveIsland(gl_WorkGroupID.x,gl_LocalInvocationIndex);
        return;
    }
    if (step.phase==8u) {
        wakeIsland(gl_WorkGroupID.x,gl_LocalInvocationIndex);
        return;
    }
    if (step.phase==9u) {
        settleIsland(gl_WorkGroupID.x,gl_LocalInvocationIndex);
        return;
    }
    if (step.phase==4u) {
        uint localIndex=gl_LocalInvocationIndex;
        findContacts(gl_WorkGroupID.x*16u+localIndex/4u,localIndex%4u,localIndex);
        return;
    }
    uint index=gl_GlobalInvocationID.x;
    if (index>=step.count) return;
    if (step.phase==1u) { solveJoint(step.first+index); return; }
    if (step.phase==2u) { solveFloor(index,step.first!=0u); return; }
    if (step.phase==6u) { findCandidates(index); return; }
    if (step.phase==5u) {
        Body b=bodies.body[index];
        if (b.samples.w!=0u) return;
        uint offset=index*8u;
        vec3 translation=vec3(uintBitsToFloat(scratch.word[offset]),uintBitsToFloat(scratch.word[offset+1u]),
                              uintBitsToFloat(scratch.word[offset+2u]));
        vec3 rotation=vec3(uintBitsToFloat(scratch.word[offset+4u]),uintBitsToFloat(scratch.word[offset+5u]),
                           uintBitsToFloat(scratch.word[offset+6u]));
        b.positionMass.xyz+=translation;
        rotateBy(b,rotation);
        // Penetration repair is not physical travel. Keep it out of the
        // velocity reconstruction, otherwise overlapping figures kick each
        // other back into the air every frame. Remove inward normal velocity
        // as a deliberately inelastic impact; tangential motion is handled
        // by the bounded contact friction above.
        b.previousPosition.xyz+=translation;
        b.previousRotation=normalize(b.previousRotation+0.5*qmul(vec4(rotation,0.0),b.previousRotation));
        float correctionLength=length(translation);
        if (correctionLength>1e-7) {
            vec3 normal=translation/correctionLength;
            float inward=dot(b.linearVelocity.xyz,normal);
            if (inward<0.0) b.linearVelocity.xyz-=normal*inward;
        }
        bodies.body[index]=b;
        return;
    }
    Body b=bodies.body[index];
    if (step.phase==0u && b.samples.w!=0u && b.samples.z!=0u &&
        scratch.word[islandState(step.first,b.samples.z-1u)+1u]!=0u) {
        b.samples.w=0u;
        saveRestReference(step.first,index,b);
        bodies.body[index]=b;
    }
    if (b.samples.w!=0u || b.positionMass.w<=0.0) return;
    if (step.phase==0u) {
        scratch.word[index*8u+3u]=0u;
        b.previousPosition=vec4(b.positionMass.xyz,0.0);
        b.previousRotation=b.rotation;
        b.linearVelocity.xyz+=step.gravityFloor.xyz*step.dt;
        b.positionMass.xyz+=b.linearVelocity.xyz*step.dt;
        rotateBy(b,b.angularVelocity.xyz*step.dt);
    } else if (step.phase==3u) {
        vec3 projectedLinear=(b.positionMass.xyz-b.previousPosition.xyz)/step.dt;
        vec4 dq=qmul(b.rotation,vec4(-b.previousRotation.xyz,b.previousRotation.w));
        if (dq.w<0.0) dq=-dq;
        vec3 projectedAngular=2.0*dq.xyz/step.dt;
        // Constraint projections repair positions, but feeding all their
        // correction back into velocity injects energy into the ragdoll.
        b.linearVelocity.xyz=mix(b.linearVelocity.xyz,projectedLinear,0.35);
        b.angularVelocity.xyz=mix(b.angularVelocity.xyz,projectedAngular,0.35);
        // Position projection can otherwise turn tiny constraint errors into
        // kinetic energy on every step. Damping and a non-bouncing floor let
        // the articulated body dissipate that energy instead of dancing.
        b.linearVelocity.xyz*=step.damping.x;
        b.angularVelocity.xyz*=step.damping.y;
        if ((scratch.word[index*8u+3u]&2u)!=0u) {
            b.linearVelocity.xyz*=step.damping.z;
            b.angularVelocity.xyz*=step.damping.w;
        }
        if (b.previousPosition.w>0.0) {
            b.linearVelocity.y=0.0;
            b.linearVelocity.xz*=step.floorDamping.x;
            b.angularVelocity.xyz*=step.floorDamping.y;
        }
        float linearSpeed=length(b.linearVelocity.xyz), angularSpeed=length(b.angularVelocity.xyz);
        if (linearSpeed>5.0) b.linearVelocity.xyz*=5.0/linearSpeed;
        if (angularSpeed>18.0) b.angularVelocity.xyz*=18.0/angularSpeed;
    }
    bodies.body[index]=b;
}
