#version 450
// Planar Newton-Euler dynamics. One invocation owns the complete small world;
// body and constraint impulses are applied symmetrically and in sequence.
layout(local_size_x=1) in;
struct Body {
    vec4 positionMass;
    vec4 rotation;
    vec4 linearVelocity;
    vec4 angularVelocity;
    vec4 inverseInertia;
    uvec4 shapes;
    vec4 material;
};
struct Joint {
    uvec4 bodies;
    vec4 parentAnchor;
    vec4 childAnchor;

};
layout(std430,set=0,binding=0) buffer Bodies { Body body[]; } bodies;
layout(std430,set=0,binding=1) readonly buffer Joints { Joint joint[]; } joints;
layout(std430,set=0,binding=2) readonly buffer Shapes { vec4 point[]; } shapes;
layout(std430,set=0,binding=3) buffer Scratch { uint word[]; } scratch;
layout(push_constant) uniform Step {
    uint phase,first,count; float dt;
    vec4 gravityFloor,dragOrigin,dragDirection;
    uvec4 dragControl;
} step;
const int MAX_BODIES=16,MAX_CONTACTS=240;
Body b[16];
struct Contact { int a,b; vec2 p,n; float depth,normalImpulse,tangentImpulse; };
Contact contacts[240];
int contactCount;
float cross2(vec2 a,vec2 c) { return a.x*c.y-a.y*c.x; }
vec2 perp(vec2 a) { return vec2(-a.y,a.x); }
vec2 rot(Body a,vec2 p) {
    float c=1.0-2.0*a.rotation.z*a.rotation.z, s=2.0*a.rotation.z*a.rotation.w;
    return vec2(c*p.x-s*p.y,s*p.x+c*p.y);
}
vec2 unrot(Body a,vec2 p) {
    float c=1.0-2.0*a.rotation.z*a.rotation.z, s=2.0*a.rotation.z*a.rotation.w;
    return vec2(c*p.x+s*p.y,-s*p.x+c*p.y);
}
void turn(inout Body a,float angle) {
    float s=sin(angle*0.5),c=cos(angle*0.5),z=a.rotation.z,w=a.rotation.w;
    a.rotation.zw=normalize(vec2(z*c+w*s,w*c-z*s));
}
vec2 velocity(Body a,vec2 r) { return a.linearVelocity.xy+a.angularVelocity.z*perp(r); }
void applyImpulse(int i,vec2 r,vec2 impulse) {
    b[i].linearVelocity.xy+=impulse*b[i].positionMass.w;
    b[i].angularVelocity.z+=cross2(r,impulse)*b[i].inverseInertia.z;
}
void applyPosition(int i,vec2 r,vec2 impulse) {
    b[i].positionMass.xy+=impulse*b[i].positionMass.w;
    turn(b[i],cross2(r,impulse)*b[i].inverseInertia.z);
}
float effective(int a,int c,vec2 ra,vec2 rb,vec2 n) {
    float x=cross2(ra,n),y=cross2(rb,n);
    return b[a].positionMass.w+b[c].positionMass.w+x*x*b[a].inverseInertia.z+y*y*b[c].inverseInertia.z;
}
void vertices(int i,out vec2 v[8]) {
    for(int j=0;j<int(b[i].shapes.y);++j)
        v[j]=b[i].positionMass.xy+rot(b[i],shapes.point[b[i].shapes.x+uint(j)].xy);
}
bool inside(vec2 p,vec2 v[8],int n) {
    for(int i=0;i<n;++i) if(cross2(v[(i+1)%n]-v[i],p-v[i]) < -1e-6) return false;
    return true;
}
bool segment(vec2 a,vec2 c,vec2 d,vec2 e,out vec2 p) {
    vec2 r=c-a,s=e-d;float den=cross2(r,s);
    if(abs(den)<1e-10) return false;
    float t=cross2(d-a,s)/den,u=cross2(d-a,r)/den;
    if(t<0.0||t>1.0||u<0.0||u>1.0) return false;
    p=a+t*r;return true;
}
bool collision(int ia,int ib,out vec2 normal,out float depth,out vec2 p0,out vec2 p1,out int points) {
    vec2 a[8],c[8];int na=int(b[ia].shapes.y),nb=int(b[ib].shapes.y); vertices(ia,a);vertices(ib,c); depth=1e30;
    for(int k=0;k<na+nb;++k) {
        vec2 edge=k<na ? a[(k+1)%na]-a[k] : c[(k-na+1)%nb]-c[k-na];
        vec2 axis=normalize(perp(edge));
        float alo=dot(a[0],axis),ahi=alo,blo=dot(c[0],axis),bhi=blo;
        for(int i=1;i<na;++i){float x=dot(a[i],axis);alo=min(alo,x);ahi=max(ahi,x);}
        for(int i=1;i<nb;++i){float x=dot(c[i],axis);blo=min(blo,x);bhi=max(bhi,x);}
        float positive=bhi-alo,negative=ahi-blo;
        if(positive<=0.0 || negative<=0.0)return false;
        float overlap=min(positive,negative);
        if(overlap<depth){depth=overlap;normal=positive<negative ? axis : -axis;}
    }
    vec2 tangent=perp(normal);float lo=1e30,hi=-1e30;points=0;
    for(int i=0;i<na;++i) if(inside(a[i],c,nb)){float t=dot(a[i],tangent);if(t<lo){lo=t;p0=a[i];}if(t>hi){hi=t;p1=a[i];}++points;}
    for(int i=0;i<nb;++i) if(inside(c[i],a,na)){float t=dot(c[i],tangent);if(t<lo){lo=t;p0=c[i];}if(t>hi){hi=t;p1=c[i];}++points;}
    for(int i=0;i<na;++i)for(int j=0;j<nb;++j){vec2 p;if(segment(a[i],a[(i+1)%na],c[j],c[(j+1)%nb],p)){
        float t=dot(p,tangent);if(t<lo){lo=t;p0=p;}if(t>hi){hi=t;p1=p;}++points;
    }}
    if(points==0)return false;
    points=(hi-lo>1e-5)?2:1;return true;
}
void findContacts(int count) {
    contactCount=0;
    for(int a=0;a<count;++a)for(int c=a+1;c<count;++c){
        if(b[a].shapes.y==0u || b[c].shapes.y==0u || b[a].positionMass.w+b[c].positionMass.w==0.0)continue;
        vec2 n,p0,p1;float depth;int points;
        if(!collision(a,c,n,depth,p0,p1,points))continue;
        for(int i=0;i<points && contactCount<MAX_CONTACTS;++i){
            Contact item;item.a=a;item.b=c;item.p=i==0?p0:p1;item.n=n;item.depth=depth;
            item.normalImpulse=0.0;item.tangentImpulse=0.0;contacts[contactCount++]=item;
        }
    }
}
void solveContact(int i) {
    Contact c=contacts[i];vec2 ra=c.p-b[c.a].positionMass.xy,rb=c.p-b[c.b].positionMass.xy;
    vec2 relative=velocity(b[c.a],ra)-velocity(b[c.b],rb);
    float k=effective(c.a,c.b,ra,rb,c.n);if(k<1e-12)return;
    float old=c.normalImpulse;c.normalImpulse=max(0.0,old-dot(relative,c.n)/k);
    vec2 impulse=c.n*(c.normalImpulse-old);
    applyImpulse(c.a,ra,impulse);applyImpulse(c.b,rb,-impulse);
    vec2 tangent=perp(c.n);relative=velocity(b[c.a],ra)-velocity(b[c.b],rb);
    k=effective(c.a,c.b,ra,rb,tangent);if(k>1e-12){
        old=c.tangentImpulse;float limit=sqrt(b[c.a].material.x*b[c.b].material.x)*c.normalImpulse;
        c.tangentImpulse=clamp(old-dot(relative,tangent)/k,-limit,limit);
        impulse=tangent*(c.tangentImpulse-old);applyImpulse(c.a,ra,impulse);applyImpulse(c.b,rb,-impulse);
    }
    contacts[i]=c;
}
void solveJointVelocity(Joint j) {
    int a=int(j.bodies.x),c=int(j.bodies.y);
    vec2 ra=rot(b[a],j.parentAnchor.xy),rb=rot(b[c],j.childAnchor.xy);
    for(int k=0;k<2;++k){vec2 n=k==0?vec2(1,0):vec2(0,1);float eff=effective(a,c,ra,rb,n);if(eff<1e-12)continue;
        float speed=dot(velocity(b[a],ra)-velocity(b[c],rb),n);vec2 impulse=-speed*n/eff;
        applyImpulse(a,ra,impulse);applyImpulse(c,rb,-impulse);
    }
}
void solvePositions(int count,int jointCount) {
    for(int iteration=0;iteration<12;++iteration){
        for(int i=0;i<jointCount;++i){Joint j=joints.joint[i];int a=int(j.bodies.x),c=int(j.bodies.y);
            for(int k=0;k<2;++k){vec2 ra=rot(b[a],j.parentAnchor.xy),rb=rot(b[c],j.childAnchor.xy);
                vec2 n=k==0?vec2(1,0):vec2(0,1);float eff=effective(a,c,ra,rb,n);if(eff<1e-12)continue;
                vec2 error=b[a].positionMass.xy+ra-b[c].positionMass.xy-rb;
                vec2 impulse=-dot(error,n)*n/eff;applyPosition(a,ra,impulse);applyPosition(c,rb,-impulse);
            }
        }
        for(int a=0;a<count;++a)for(int c=a+1;c<count;++c){
            if(b[a].shapes.y==0u||b[c].shapes.y==0u||b[a].positionMass.w+b[c].positionMass.w==0.0)continue;
            vec2 n,p0,p1;float depth;int points;if(!collision(a,c,n,depth,p0,p1,points))continue;
            vec2 p=(p0+p1)*0.5,ra=p-b[a].positionMass.xy,rb=p-b[c].positionMass.xy;
            float eff=effective(a,c,ra,rb,n);if(eff<1e-12)continue;
            vec2 impulse=n*(0.8*max(depth-0.00001,0.0)/eff);
            applyPosition(a,ra,impulse);applyPosition(c,rb,-impulse);
        }
    }
}
void main(){
    int count=int(step.first),jointCount=int(step.count);
    if(count>MAX_BODIES)return;
    for(int i=0;i<count;++i)b[i]=bodies.body[i];
    if(step.dragControl.x!=0u && abs(step.dragDirection.z)>1e-6){
        vec2 target=step.dragOrigin.xy-step.dragDirection.xy*(step.dragOrigin.z/step.dragDirection.z);
        if(scratch.word[0]!=step.dragControl.y){
            scratch.word[0]=step.dragControl.y;scratch.word[1]=0u;
            for(int i=count-1;i>=0;--i) if(b[i].positionMass.w>0.0 && b[i].shapes.y>=3u){
                vec2 v[8];vertices(i,v);
                if(inside(target,v,int(b[i].shapes.y))){vec2 anchor=unrot(b[i],target-b[i].positionMass.xy);
                    scratch.word[1]=uint(i+1);scratch.word[2]=floatBitsToUint(anchor.x);scratch.word[3]=floatBitsToUint(anchor.y);break;}
            }
        }
        if(scratch.word[1]>0u && scratch.word[1]<=uint(count)){
            int i=int(scratch.word[1]-1u);vec2 r=rot(b[i],vec2(uintBitsToFloat(scratch.word[2]),uintBitsToFloat(scratch.word[3])));
            float mass=1.0/b[i].positionMass.w,frequency=15.0;
            vec2 force=mass*(frequency*frequency*(target-b[i].positionMass.xy-r)-2.0*frequency*velocity(b[i],r));
            applyImpulse(i,r,force*step.dt);
        }
    }
    for(int i=0;i<count;++i)if(b[i].positionMass.w>0.0){
        b[i].linearVelocity.xy+=step.gravityFloor.xy*step.dt;
        b[i].positionMass.xy+=b[i].linearVelocity.xy*step.dt;
        turn(b[i],b[i].angularVelocity.z*step.dt);
    }
    findContacts(count);
    for(int iteration=0;iteration<32;++iteration){
        for(int j=0;j<jointCount;++j)solveJointVelocity(joints.joint[j]);
        for(int c=0;c<contactCount;++c)solveContact(c);
    }
    solvePositions(count,jointCount);
    for(int i=0;i<count;++i)bodies.body[i]=b[i];
}
