// Clip the convex cross-section by a flat liquid surface, then calculate
// signed area and the centerOfArea of the displaced extruded volume.
void submerged(int index,bool below,out float area,out vec2 centerOfArea) {
    vec2 src[16],v[17];vertices(index,src);int n=int(b[index].shapes.y),m=0;
    float level=step.medium.z;
