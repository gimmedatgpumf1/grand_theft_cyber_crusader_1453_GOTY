#version 450
// Planar Newton-Euler dynamics. One workgroup owns a world; body updates
// and disjoint constraint pairs run on separate synchronized GPU lanes.
layout(local_size_x=32) in;
struct Body {
    vec4 positionMass;
    vec4 rotation;
    vec4 linearVelocity;
    vec4 angularVelocity;
    vec4 inverseInertia;
    uvec4 shapes;
    vec4 material;
};
struct Joint {
    uvec4 bodies;
    vec4 parentAnchor;
    vec4 childAnchor;

};
layout(std430,set=0,binding=0) buffer Bodies { Body body[]; } bodies;
layout(std430,set=0,binding=1) readonly buffer Joints { Joint joint[]; } joints;
layout(std430,set=0,binding=2) readonly buffer Shapes { vec4 point[]; } shapes;
layout(std430,set=0,binding=3) buffer Scratch { uint word[]; } scratch;
layout(push_constant) uniform Step {
    uint phase,first,count; float dt;
    vec4 gravityFloor,dragOrigin,dragDirection;
    uvec4 dragControl;
    vec4 medium; // air density, liquid density, liquid level, reserved
    vec4 fluidVelocity; // air xy, liquid xy
} step;
const int MAX_BODIES=24,MAX_VERTICES=16,MAX_PAIRS=276;
shared Body b[MAX_BODIES];
struct PairContact {
    vec2 p0,p1,n;
    float bounce;
    uint count;
    vec2 normalImpulse,tangentImpulse;
};
shared PairContact pairs[MAX_PAIRS];
shared int dragged;
shared vec2 dragAnchor,dragTarget;
shared vec2 impactDisplacement[MAX_BODIES];
shared float impactRotation[MAX_BODIES];
float cross2(vec2 a,vec2 c) { return a.x*c.y-a.y*c.x; }
vec2 perp(vec2 a) { return vec2(-a.y,a.x); }
vec2 rot(Body a,vec2 p) {
    float c=1.0-2.0*a.rotation.z*a.rotation.z, s=2.0*a.rotation.z*a.rotation.w;
    return vec2(c*p.x-s*p.y,s*p.x+c*p.y);
}
vec2 unrot(Body a,vec2 p) {
    float c=1.0-2.0*a.rotation.z*a.rotation.z, s=2.0*a.rotation.z*a.rotation.w;
    return vec2(c*p.x+s*p.y,-s*p.x+c*p.y);
