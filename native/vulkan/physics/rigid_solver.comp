    vec2 airForce=-step.gravityFloor.xy*(step.medium.x*aboveArea)*body.material.y;
    vec2 waterForce=-step.gravityFloor.xy*(step.medium.y*belowArea)*body.material.y;
    force+=fb;torque+=cross2(aboveCenter-body.positionMass.xy,airForce)+cross2(belowCenter-body.positionMass.xy,waterForce);
    vec2 v[16];vertices(index,v);int n=int(body.shapes.y);float level=step.medium.z;
    for(int i=0;i<n;++i){vec2 p=v[i],q=v[(i+1)%n];
        bool pBelow=p.y<level,qBelow=q.y<level;
        if(pBelow==qBelow)edgeDrag(index,p,q,pBelow?step.medium.y:step.medium.x,pBelow?step.fluidVelocity.zw:step.fluidVelocity.xy,force,torque);
        else {vec2 cut=mix(p,q,(level-p.y)/(q.y-p.y));
            edgeDrag(index,p,cut,pBelow?step.medium.y:step.medium.x,pBelow?step.fluidVelocity.zw:step.fluidVelocity.xy,force,torque);
            edgeDrag(index,cut,q,qBelow?step.medium.y:step.medium.x,qBelow?step.fluidVelocity.zw:step.fluidVelocity.xy,force,torque);
        }
    }
}
// Round-robin edge coloring of the complete body graph. Each round pairs
// every body at most once; all pairs in the round safely solve concurrently.
ivec2 scheduledPair(int lane,int round,int count) {
    int n=count+(count%2), ring=n-1;
    int a=lane==0?n-1:(round+lane)%ring;
    int c=(round+ring-lane)%ring;
    if(a>c){int t=a;a=c;c=t;}
    return ivec2(a,c);
}
void main(){
    int lane=int(gl_LocalInvocationIndex),count=int(step.first),jointCount=int(step.count);
    if(count>MAX_BODIES)return; // uniform over the workgroup
    if(lane<count){b[lane]=bodies.body[lane];impactDisplacement[lane]=vec2(0);impactRotation[lane]=0.0;}
    barrier();
    if(lane==0){
        dragged=-1;dragTarget=vec2(0);dragAnchor=vec2(0);
        if(step.dragControl.x!=0u && abs(step.dragDirection.z)>1e-6){
            dragTarget=step.dragOrigin.xy-step.dragDirection.xy*(step.dragOrigin.z/step.dragDirection.z);
            if(scratch.word[0]!=step.dragControl.y){
                scratch.word[0]=step.dragControl.y;scratch.word[1]=0u;
                for(int i=count-1;i>=0;--i)if(b[i].positionMass.w>0.0 && b[i].shapes.y>=3u){
                    vec2 v[16];vertices(i,v);
                    if(inside(dragTarget,v,int(b[i].shapes.y))){vec2 anchor=unrot(b[i],dragTarget-b[i].positionMass.xy);
                        scratch.word[1]=uint(i+1);scratch.word[2]=floatBitsToUint(anchor.x);scratch.word[3]=floatBitsToUint(anchor.y);break;}
                }
            }
            if(scratch.word[1]>0u && scratch.word[1]<=uint(count)){
                dragged=int(scratch.word[1]-1u);
                dragAnchor=vec2(uintBitsToFloat(scratch.word[2]),uintBitsToFloat(scratch.word[3]));
            }
        }
    }
    barrier();
    if(lane<count && b[lane].positionMass.w>0.0){
        float mass=1.0/b[lane].positionMass.w;vec2 force=mass*step.gravityFloor.xy;float torque=0.0;
        applyFluidForces(lane,force,torque);
        if(lane==dragged){vec2 r=rot(b[lane],dragAnchor);float omega=15.0;
            vec2 f=mass*(omega*omega*(dragTarget-b[lane].positionMass.xy-r)-2.0*omega*velocity(b[lane],r));
            force+=f;torque+=cross2(r,f);
        }
        b[lane].linearVelocity.xy+=force*b[lane].positionMass.w*step.dt;
        b[lane].angularVelocity.z+=torque*b[lane].inverseInertia.z*step.dt;
    }
    barrier();
    if(lane<count)for(int c=lane+1;c<count;++c)makeContact(lane,c,count);
    barrier();
    int n=count+(count%2);
    for(int iteration=0;iteration<32;++iteration)for(int round=0;round<n-1;++round){
        if(lane<n/2){ivec2 pair=scheduledPair(lane,round,count);int a=pair.x,c=pair.y;
            if(c<count){
                for(int j=0;j<jointCount;++j){Joint joint=joints.joint[j];
                    if(min(joint.bodies.x,joint.bodies.y)==uint(a) && max(joint.bodies.x,joint.bodies.y)==uint(c))solveJointVelocity(joint);
                }
                solveContact(a,c,pairIndex(a,c,count));
            }
        }
        barrier();
    }
    if(lane<count && b[lane].positionMass.w>0.0){
        b[lane].positionMass.xy+=b[lane].linearVelocity.xy*step.dt+impactDisplacement[lane];
        turn(b[lane],b[lane].angularVelocity.z*step.dt+impactRotation[lane]);
    }
    barrier();
    for(int iteration=0;iteration<12;++iteration)for(int round=0;round<n-1;++round){
        if(lane<n/2){ivec2 pair=scheduledPair(lane,round,count);int a=pair.x,c=pair.y;
            if(c<count){
                for(int j=0;j<jointCount;++j){Joint joint=joints.joint[j];
                    if(min(joint.bodies.x,joint.bodies.y)==uint(a) && max(joint.bodies.x,joint.bodies.y)==uint(c))solveJointPosition(joint);
                }
                solvePosition(a,c);
            }
        }
        barrier();
    }
    if(lane<count)bodies.body[lane]=b[lane];
}
