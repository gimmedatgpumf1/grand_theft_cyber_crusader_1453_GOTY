// Integrate pressure drag on each wetted edge. A Cd is supplied by the
// material; the law is quadratic and neglects wake and fluid displacement.
void edgeDrag(int index,vec2 p,vec2 q,float density,vec2 flow,inout vec2 force,inout float torque) {
