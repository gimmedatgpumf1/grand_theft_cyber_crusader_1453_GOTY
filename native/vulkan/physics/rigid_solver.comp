    // existing overlaps; it does not grant a general no-penetration guarantee.
    for(int iteration=0;iteration<12;++iteration)for(int round=0;round<n-1;++round){
        for(int slot=lane;slot<n/2;slot+=32){ivec2 pair=scheduledPair(slot,round,count);int a=pair.x,c=pair.y;
            if(c<count){
                for(int j=0;j<jointCount;++j){Joint joint=joints.joint[j];
                    if(min(joint.bodies.x,joint.bodies.y)==uint(a) && max(joint.bodies.x,joint.bodies.y)==uint(c))solveJointPosition(joint);
                }
                solvePosition(a,c);
            }
        }
        memoryBarrierBuffer();barrier();
    }
}
