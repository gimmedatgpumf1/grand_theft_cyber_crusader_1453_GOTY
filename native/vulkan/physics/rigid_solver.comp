// Conservative advancement for rotating convex polygons. SAT provides a
// separating-plane lower bound; the relative linear speed plus the angular
// speeds times their radii is an upper bound on approach speed.
void verticesAtTime(int body,float t,out vec2 v[16]) {
    vec2 base[16];vertices(body,base);
    vec2 pos=b[body].positionMass.xy, shift=b[body].linearVelocity.xy*t;
    float angle=b[body].angularVelocity.z*t,c=cos(angle),sn=sin(angle);
    for(int i=0;i<int(b[body].shapes.y);++i){vec2 r=base[i]-pos;
        v[i]=pos+shift+vec2(c*r.x-sn*r.y,sn*r.x+c*r.y);
    }
}
float separationAtTime(int ia,int ib,float time,out vec2 normal,out vec2 a[16],out vec2 c[16]) {
    verticesAtTime(ia,time,a);verticesAtTime(ib,time,c);
    int na=int(b[ia].shapes.y),nb=int(b[ib].shapes.y);float separation=-1e30;
    for(int k=0;k<na+nb;++k){
        vec2 edge=k<na ? a[(k+1)%na]-a[k] : c[(k-na+1)%nb]-c[k-na];
        vec2 axis=normalize(perp(edge));
        float alo=dot(a[0],axis),ahi=alo,blo=dot(c[0],axis),bhi=blo;
        for(int i=1;i<na;++i){float x=dot(a[i],axis);alo=min(alo,x);ahi=max(ahi,x);}
        for(int i=1;i<nb;++i){float x=dot(c[i],axis);blo=min(blo,x);bhi=max(bhi,x);}
        float pos=alo-bhi,neg=blo-ahi;
        if(max(pos,neg)>separation){separation=max(pos,neg);normal=pos>neg?axis:-axis;}
    }
