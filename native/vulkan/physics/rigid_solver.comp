#version 450

// Work-in-progress Vulkan rigid-body solver. Not connected to the game yet.
// Joint batches must be graph-coloured: no two joints in one dispatch may
// reference the same body. Insert a compute-write -> compute-read/write barrier
// between dispatches. Coordinates are metres, seconds, and radians.
layout(local_size_x = 64) in;

struct Body {
    vec4 positionMass;    // world centre, inverse mass
    vec4 rotation;        // local-to-world quaternion, xyzw
    vec4 linearVelocity;
    vec4 angularVelocity;
    vec4 inverseInertia;  // xyz: local-space inverse inertia, w: bounding radius
    vec4 previousPosition; // w is set when a floor contact is resolved
    vec4 previousRotation;
    uvec4 samples;        // x: first sphere, y: sphere count
};
struct Joint {
    uvec4 bodies;         // x = parent body, y = child body
    vec4 parentAnchor;    // body-local anchor
    vec4 childAnchor;
    vec4 parentAxis;      // xyz local axis, w lower angle
    vec4 childAxis;       // xyz local axis, w upper angle
    vec4 parentTangent;
    vec4 childTangent;
    vec4 lowerAngles;
    vec4 upperAngles;
};
layout(std430, set=0, binding=0) buffer Bodies { Body body[]; } bodies;
layout(std430, set=0, binding=1) readonly buffer Joints { Joint joint[]; } joints;
layout(std430, set=0, binding=2) readonly buffer Samples { vec4 point[]; } samples;
// Eight scratch words per body, followed by a symmetric bodyCount x bodyCount
// exclusion bitset. This fits the four storage buffers guaranteed by Vulkan 1.0.
layout(std430, set=0, binding=3) buffer Scratch { uint word[]; } scratch;
layout(push_constant) uniform Step {
    uint phase;           // predict, joint, floor, velocity, contacts, apply
    uint first;           // joint offset, or body count in contacts phase
    uint count;           // number of bodies or joints in this dispatch
    float dt;
    vec4 gravityFloor;    // gravity xyz and floor height
} step;

vec4 qmul(vec4 a, vec4 b) {
    return vec4(a.w*b.xyz+b.w*a.xyz+cross(a.xyz,b.xyz), a.w*b.w-dot(a.xyz,b.xyz));
}
vec3 rotate(vec4 q, vec3 v) {
    return v + 2.0*cross(q.xyz,cross(q.xyz,v)+q.w*v);
}
vec3 invInertia(Body b, vec3 worldVector) {
    vec4 inverseQ=vec4(-b.rotation.xyz,b.rotation.w);
    return rotate(b.rotation,rotate(inverseQ,worldVector)*b.inverseInertia.xyz);
}
void rotateBy(inout Body b, vec3 delta) {
    b.rotation=normalize(b.rotation+0.5*qmul(vec4(delta,0.0),b.rotation));
}

void solveAngular(inout Body a, inout Body b, vec3 axis, float error) {
    vec3 ia=invInertia(a,axis), ib=invInertia(b,axis);
    float effective=dot(axis,ia+ib);
    if (effective<=1e-12) return;
    float impulse=error/effective;
    rotateBy(a,ia*impulse);
    rotateBy(b,-ib*impulse);
}

// Hinge: align its two axes, then clamp the signed twist. Axis and tangent
// frames are captured from the initial calibrated rig. Ball joints remain
// unconstrained in orientation until their cone limits are implemented.
void solveHinge(inout Body a, inout Body b, Joint j) {
    vec3 axisA=normalize(rotate(a.rotation,j.parentAxis.xyz));
    vec3 axisB=normalize(rotate(b.rotation,j.childAxis.xyz));
    vec3 crossAxis=cross(axisA,axisB);
    float sine=length(crossAxis), cosine=clamp(dot(axisA,axisB),-1.0,1.0);
    if (sine>1e-6) solveAngular(a,b,crossAxis/sine,atan(sine,cosine));
    else if (cosine<0.0) solveAngular(a,b,normalize(rotate(a.rotation,j.parentTangent.xyz)),3.14159265);
    axisA=normalize(rotate(a.rotation,j.parentAxis.xyz));
    vec3 tangentA=rotate(a.rotation,j.parentTangent.xyz);
    vec3 tangentB=rotate(b.rotation,j.childTangent.xyz);
    tangentA-=axisA*dot(axisA,tangentA);
    tangentB-=axisA*dot(axisA,tangentB);
    float aa=length(tangentA), bb=length(tangentB);
    if (aa<1e-6 || bb<1e-6) return;
    tangentA/=aa; tangentB/=bb;
    float angle=atan(dot(axisA,cross(tangentA,tangentB)),dot(tangentA,tangentB));
    solveAngular(a,b,axisA,angle-clamp(angle,j.parentAxis.w,j.childAxis.w));
}

// Approximate the three angular coordinates by intrinsic XYZ angles in the
// fitted joint frame. This is not a coupled anatomical limit surface and has
// the usual Euler singularity near 90 degrees of the middle coordinate.
void solveBall(inout Body a, inout Body b, Joint j) {
    for (int k=0;k<3;++k) {
        vec3 x=normalize(j.parentAxis.xyz), y=normalize(j.parentTangent.xyz), z=normalize(cross(x,y));
        vec3 bx=normalize(j.childAxis.xyz), by=normalize(j.childTangent.xyz), bz=normalize(cross(bx,by));
        vec4 relative=qmul(vec4(-a.rotation.xyz,a.rotation.w),b.rotation);
        vec3 rx=rotate(relative,bx), ry=rotate(relative,by), rz=rotate(relative,bz);
        float middle=asin(clamp(dot(x,rz),-1.0,1.0));
        float first=atan(-dot(y,rz),dot(z,rz));
        float last=atan(-dot(x,ry),dot(x,rx));
        float angles[3]=float[3](first,middle,last);
        float error=angles[k]-clamp(angles[k],j.lowerAngles[k],j.upperAngles[k]);
        if (abs(error)<1e-6) continue;
        vec3 worldX=rotate(a.rotation,x), worldY=rotate(a.rotation,y), worldZ=rotate(a.rotation,z);
        vec4 firstTurn=vec4(worldX*sin(first*0.5),cos(first*0.5));
        worldY=rotate(firstTurn,worldY); worldZ=rotate(firstTurn,worldZ);
        vec4 middleTurn=vec4(worldY*sin(middle*0.5),cos(middle*0.5));
        worldZ=rotate(middleTurn,worldZ);
        solveAngular(a,b,k==0 ? worldX : (k==1 ? worldY : worldZ),error);
    }
}

// Corrects the separation of the two calibrated anchors. A coloured batch
// makes each body writable by just one invocation, without float atomics.
void solveJoint(uint index) {
    Joint j=joints.joint[index];
    Body a=bodies.body[j.bodies.x], b=bodies.body[j.bodies.y];
    for (int k=0;k<3;++k) {
        vec3 n=vec3(k==0 ? 1.0 : 0.0,k==1 ? 1.0 : 0.0,k==2 ? 1.0 : 0.0);
        vec3 ra=rotate(a.rotation,j.parentAnchor.xyz);
        vec3 rb=rotate(b.rotation,j.childAnchor.xyz);
        float error=dot((b.positionMass.xyz+rb)-(a.positionMass.xyz+ra),n);
        vec3 aa=cross(ra,n), ab=cross(rb,n);
        vec3 ia=invInertia(a,aa), ib=invInertia(b,ab);
        float effective=a.positionMass.w+b.positionMass.w+dot(aa,ia)+dot(ab,ib);
        if (effective<=1e-12) continue;
        float impulse=error/effective;
        a.positionMass.xyz+=n*(impulse*a.positionMass.w);
        b.positionMass.xyz-=n*(impulse*b.positionMass.w);
        rotateBy(a,ia*impulse);
        rotateBy(b,-ib*impulse);
    }
    if (j.bodies.z==0u) solveBall(a,b,j);
    else if (j.bodies.z==1u) solveHinge(a,b,j);
    // Angular correction can move anchors apart again. Close the remaining
    // gap by inverse-mass weighted translation, just as the old hand solver
    // projected tiny finger anchors after constraint solving.
    float weight=a.positionMass.w+b.positionMass.w;
    if (weight>1e-12) {
        vec3 separation=(b.positionMass.xyz+rotate(b.rotation,j.childAnchor.xyz))-
                        (a.positionMass.xyz+rotate(a.rotation,j.parentAnchor.xyz));
        a.positionMass.xyz+=separation*(a.positionMass.w/weight);
        b.positionMass.xyz-=separation*(b.positionMass.w/weight);
    }
    bodies.body[j.bodies.x]=a;
    bodies.body[j.bodies.y]=b;
}

// Floor support points are local to their rigid body. A body owns all its
// support points, so this phase is also one writer per body.
void solveFloor(uint index) {
    Body b=bodies.body[index];
    if (b.positionMass.w<=0.0) return;
    float lowest=step.gravityFloor.w;
    vec3 arm=vec3(0.0);
    for (uint i=0u;i<b.samples.y;++i) {
        vec4 sphere=samples.point[b.samples.x+i];
        vec3 r=rotate(b.rotation,sphere.xyz);
        float y=b.positionMass.y+r.y-sphere.w;
        if (y<lowest) { lowest=y; arm=r-vec3(0.0,sphere.w,0.0); }
    }
    if (lowest<step.gravityFloor.w) {
        vec3 n=vec3(0.0,1.0,0.0);
        vec3 torque=cross(arm,n), angular=invInertia(b,torque);
        float effective=b.positionMass.w+dot(torque,angular);
        if (effective>1e-12) {
            float impulse=(step.gravityFloor.w-lowest)/effective;
            b.positionMass.xyz+=n*(impulse*b.positionMass.w);
            rotateBy(b,angular*impulse);
            b.previousPosition.w=1.0;
        }
    }
    bodies.body[index]=b;
}

// Jacobi contact pass: one invocation reads all candidate bodies and writes
// only its own correction. A separate dispatch applies the corrections. The
// broad phase is intentionally simple all-pairs bounding spheres for now; it
// needs a spatial accelerator before this is suitable for a larger scene.
void findContacts(uint index) {
    Body a=bodies.body[index];
    vec3 positionDelta=vec3(0.0), rotationDelta=vec3(0.0);
    float contactCount=0.0;
    uint bodyCount=step.first;
    uint stride=(bodyCount+31u)/32u;
    if (a.positionMass.w>0.0) for (uint other=0u;other<bodyCount;++other) {
        if (other==index || (scratch.word[bodyCount*8u+index*stride+other/32u] & (1u<<(other%32u)))!=0u) continue;
        Body b=bodies.body[other];
        float extent=a.inverseInertia.w+b.inverseInertia.w;
        vec3 separation=a.positionMass.xyz-b.positionMass.xyz;
        if (dot(separation,separation)>extent*extent) continue;
        float depth=0.0;
        vec3 bestNormal=vec3(0.0), armA=vec3(0.0), armB=vec3(0.0);
        for (uint i=0u;i<a.samples.y;++i) {
            vec4 sa=samples.point[a.samples.x+i];
            vec3 ra=rotate(a.rotation,sa.xyz);
            vec3 centerDistance=separation+ra;
            float candidateRadius=b.inverseInertia.w+sa.w;
            if (dot(centerDistance,centerDistance)>candidateRadius*candidateRadius) continue;
            for (uint j=0u;j<b.samples.y;++j) {
                vec4 sb=samples.point[b.samples.x+j];
                vec3 rb=rotate(b.rotation,sb.xyz);
                vec3 d=separation+ra-rb;
                float radius=sa.w+sb.w, distanceSquared=dot(d,d);
                if (distanceSquared>=radius*radius) continue;
                float distance=sqrt(distanceSquared), overlap=radius-distance;
                if (overlap<=depth) continue;
                vec3 n=distance>1e-7 ? d/distance : vec3(index<other ? -1.0 : 1.0,0.0,0.0);
                depth=overlap; bestNormal=n;
                armA=ra-n*sa.w; armB=rb+n*sb.w;
            }
        }
        if (depth<=0.0) continue;
        vec3 ta=cross(armA,bestNormal), tb=cross(armB,bestNormal);
        vec3 ia=invInertia(a,ta), ib=invInertia(b,tb);
        float effective=a.positionMass.w+b.positionMass.w+dot(ta,ia)+dot(tb,ib);
        if (effective<=1e-12) continue;
        float impulse=depth/effective;
        positionDelta+=bestNormal*(impulse*a.positionMass.w);
        rotationDelta+=ia*impulse;
        contactCount+=1.0;
    }
    float scale=contactCount>0.0 ? 0.8/max(1.0,contactCount) : 0.0;
    vec3 translation=positionDelta*scale, rotation=rotationDelta*scale;
    uint offset=index*8u;
    for (uint k=0u;k<3u;++k) {
        scratch.word[offset+k]=floatBitsToUint(translation[k]);
        scratch.word[offset+4u+k]=floatBitsToUint(rotation[k]);
    }
}

void main() {
    uint index=gl_GlobalInvocationID.x;
    if (index>=step.count) return;
    if (step.phase==1u) { solveJoint(step.first+index); return; }
    if (step.phase==2u) { solveFloor(index); return; }
    if (step.phase==4u) { findContacts(index); return; }
    if (step.phase==5u) {
        Body b=bodies.body[index];
        uint offset=index*8u;
        vec3 translation=vec3(uintBitsToFloat(scratch.word[offset]),uintBitsToFloat(scratch.word[offset+1u]),
                              uintBitsToFloat(scratch.word[offset+2u]));
        vec3 rotation=vec3(uintBitsToFloat(scratch.word[offset+4u]),uintBitsToFloat(scratch.word[offset+5u]),
                           uintBitsToFloat(scratch.word[offset+6u]));
        b.positionMass.xyz+=translation;
        rotateBy(b,rotation);
        bodies.body[index]=b;
        return;
    }
    Body b=bodies.body[index];
    if (b.positionMass.w<=0.0) return;
    if (step.phase==0u) {
        b.previousPosition=vec4(b.positionMass.xyz,0.0);
        b.previousRotation=b.rotation;
        b.linearVelocity.xyz+=step.gravityFloor.xyz*step.dt;
        b.positionMass.xyz+=b.linearVelocity.xyz*step.dt;
        rotateBy(b,b.angularVelocity.xyz*step.dt);
    } else if (step.phase==3u) {
        b.linearVelocity.xyz=(b.positionMass.xyz-b.previousPosition.xyz)/step.dt;
        vec4 dq=qmul(b.rotation,vec4(-b.previousRotation.xyz,b.previousRotation.w));
        if (dq.w<0.0) dq=-dq;
        b.angularVelocity.xyz=2.0*dq.xyz/step.dt;
        if (b.previousPosition.w>0.0) b.linearVelocity.xz*=0.9;
    }
    bodies.body[index]=b;
}
