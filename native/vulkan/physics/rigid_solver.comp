            }
            vec2 normal,anchorA,anchorB;float gap,time;
            // Always sweep translation. Use rotational advancement when the
            // maximum point displacement is significant relative to shape
            // thickness; slow rotations use the discrete substep contacts.
            bool rotating=continuous && (b[a].angularVelocity.z!=0.0 || b[c].angularVelocity.z!=0.0);
            int kind=rotating ? rotationalSweep(a,c,remaining,normal,anchorA,anchorB,gap,time) :
                               (sweptContact(a,c,remaining,normal,anchorA,anchorB,gap,time)?1:0);
            if(kind==1){
                vec2 ra=anchorA-b[a].positionMass.xy,rb=anchorB-b[c].positionMass.xy;
