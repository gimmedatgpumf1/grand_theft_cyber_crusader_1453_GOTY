bool rotationalSweep(int ia,int ib,out vec2 n,out vec2 anchorA,out vec2 anchorB,out float gap,out float impactTime) {
    int na=int(b[ia].shapes.y),nb=int(b[ib].shapes.y);vec2 initialA[16],initialB[16];
    vertices(ia,initialA);vertices(ib,initialB);float ra=0.0,rb=0.0;
    for(int i=0;i<na;++i)ra=max(ra,length(initialA[i]-b[ia].positionMass.xy));
    for(int i=0;i<nb;++i)rb=max(rb,length(initialB[i]-b[ib].positionMass.xy));
    vec2 va=b[ia].linearVelocity.xy,vb=b[ib].linearVelocity.xy;
    float bound=length(va-vb)+abs(b[ia].angularVelocity.z)*ra+abs(b[ib].angularVelocity.z)*rb;
    if(bound<1e-8)return false;
    vec2 a[16],c[16];float time=0.0;bool hit=false;
