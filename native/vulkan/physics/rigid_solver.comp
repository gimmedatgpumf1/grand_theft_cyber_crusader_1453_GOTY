// Pair storage uses a triangular array, independent of the scheduling order.
int pairIndex(int a,int c,int count) { return a*(2*count-a-1)/2+(c-a-1); }
void makeContact(int a,int c,int count) {
    PairContact p;p.p0=vec2(0);p.p1=vec2(0);p.n=vec2(0);p.bounce=0.0;
    p.count=0u;p.normalImpulse=vec2(0);p.tangentImpulse=vec2(0);
    if(b[a].shapes.y>=3u && b[c].shapes.y>=3u && b[a].positionMass.w+b[c].positionMass.w>0.0){
        int points;vec2 n,p0,p1;float depth;
