// Continuous SAT for convex polygons translating at constant velocity during
// this step. Rotations are integrated separately; this sweep does not include
// angular motion. It returns one speculative normal constraint.
bool sweptContact(int ia,int ib,out vec2 n,out vec2 anchorA,out vec2 anchorB,out float gap,out float impactTime) {
    vec2 a[16],c[16];int na=int(b[ia].shapes.y),nb=int(b[ib].shapes.y);
    vertices(ia,a);vertices(ib,c);
    vec2 va=b[ia].linearVelocity.xy,vc=b[ib].linearVelocity.xy,relative=va-vc;
    float enter=-1e30,exit=1e30;bool haveAxis=false;
    for(int k=0;k<na+nb;++k){
        vec2 edge=k<na ? a[(k+1)%na]-a[k] : c[(k-na+1)%nb]-c[k-na];
        vec2 axis=normalize(perp(edge));
        float alo=dot(a[0],axis),ahi=alo,blo=dot(c[0],axis),bhi=blo;
        for(int i=1;i<na;++i){float x=dot(a[i],axis);alo=min(alo,x);ahi=max(ahi,x);}
        for(int i=1;i<nb;++i){float x=dot(c[i],axis);blo=min(blo,x);bhi=max(bhi,x);}
        float speed=dot(relative,axis);
