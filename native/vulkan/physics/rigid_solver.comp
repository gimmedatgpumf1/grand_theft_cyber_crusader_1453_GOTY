    vec2 n,p0,p1;float depth;int points;if(!collision(a,c,n,depth,p0,p1,points))return;
    vec2 p=(p0+p1)*0.5,ra=p-b[a].positionMass.xy,rb=p-b[c].positionMass.xy;
    float eff=effective(a,c,ra,rb,n);if(eff<1e-12)return;
