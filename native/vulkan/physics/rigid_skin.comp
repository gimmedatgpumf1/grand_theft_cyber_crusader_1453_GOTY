#version 450

// Converts simulation bodies into batch matrices without CPU readback.
// The renderer must supply one distinct matrix slot per binding.
layout(local_size_x=64) in;
struct Body {
    vec4 positionMass;
    vec4 rotation;
    vec4 linearVelocity;
    vec4 angularVelocity;
    vec4 inverseInertia;
    vec4 previousPosition;
    vec4 previousRotation;
    uvec4 samples;
    vec4 bounds;
};
struct Binding {
    mat4 localFromMesh;
    uvec4 indices; // x body index, y renderer matrix slot
};
layout(std430,set=0,binding=0) readonly buffer Bodies { Body body[]; } bodies;
layout(std430,set=0,binding=1) readonly buffer Bindings { Binding item[]; } bindings;
layout(std430,set=0,binding=2) buffer Matrices { mat4 matrix[]; } matrices;
layout(push_constant) uniform Params { uint count; } params;

void main() {
    uint i=gl_GlobalInvocationID.x;
    if (i>=params.count) return;
    Binding binding=bindings.item[i];
    Body body=bodies.body[binding.indices.x];
    vec4 q=body.rotation;
    float x=q.x, y=q.y, z=q.z, w=q.w;
    mat4 transform=mat4(
        vec4(1.0-2.0*(y*y+z*z),2.0*(x*y+z*w),2.0*(x*z-y*w),0.0),
        vec4(2.0*(x*y-z*w),1.0-2.0*(x*x+z*z),2.0*(y*z+x*w),0.0),
        vec4(2.0*(x*z+y*w),2.0*(y*z-x*w),1.0-2.0*(x*x+y*y),0.0),
        vec4(body.positionMass.xyz,1.0));
    matrices.matrix[binding.indices.y]=transform*binding.localFromMesh;
}
